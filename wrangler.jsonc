{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Cloudflare Pages project name. Must match the project you connect in
  // the Cloudflare dashboard (or the one `wrangler pages deploy` creates).
  "name": "musfikur-lab",

  // Used to opt this Worker/Pages runtime into the latest platform
  // behaviour. Bump forward when you're ready to test newer defaults.
  "compatibility_date": "2025-09-04",

  // `next build` (output: 'export') writes static HTML/CSS/JS here.
  // This is what makes `wrangler pages deploy` / `wrangler pages dev`
  // work without extra flags.
  "pages_build_output_dir": "out"
}
