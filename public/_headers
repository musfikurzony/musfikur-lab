# Cloudflare response headers. Read from the deployed output on both the
# Workers and Pages hosting paths.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Hashed build assets never change under the same name.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The social sharing card.
#
# Next writes this file as `opengraph-image` with NO extension, so the host
# cannot infer its type and serves it as application/octet-stream. LinkedIn,
# WhatsApp and X all refuse to render a preview image that is not declared as
# an image, so the card would silently never appear.
#
# `nosniff` above is set site-wide and correctly stops the browser guessing,
# which makes declaring the type here necessary rather than optional.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600
