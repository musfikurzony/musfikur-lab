# ============================================================================
# ALTERNATIVE CONFIG — only if your project is a PAGES project
# ============================================================================
#
# You need this file ONLY if your Cloudflare dashboard URL looks like:
#
#   https://dash.cloudflare.com/<account>/pages/view/musfikur-lab
#
# If it says /workers/services/view/... instead, ignore this file entirely and
# keep the wrangler.toml that ships with the repo.
#
# TO USE IT:
#   1. Delete wrangler.toml
#   2. Rename this file to wrangler.toml
#   3. In Cloudflare → Settings → Builds & deployments, set:
#        Build command:            npm run build
#        Build output directory:   out
#      (A Pages project has no "Deploy command" field.)
#   4. Commit and push
#
# Either path serves this site identically — same edge network, same speed,
# same cost, and no server code in either case.
# ============================================================================

name = "musfikur-lab"
compatibility_date = "2026-09-04"

# Pages-only key. A Workers project cannot read this.
pages_build_output_dir = "out"

# ----------------------------------------------------------------------------
# Environment variables are NOT set here — this file is committed to Git.
# Set them in the Cloudflare dashboard. See .env.example.
# ----------------------------------------------------------------------------
